#!/bin/sh
# The fast local gate: types repo-wide, lint on what is staged. [ENGINEERING §4.6]
set -e
bun run typecheck
./node_modules/.bin/biome check --staged --no-errors-on-unmatched

# ENGINEERING §1.4 "never cast with `as`". Biome's noExplicitAny catches `as any` only, so the
# rest of the rule is a grep — a NEVER rule must not claim enforcement it does not have.
# Capture the hits rather than branching on the pipeline: xargs exits 0 when it runs nothing,
# so `if <pipeline>` fires on every commit that stages no TypeScript at all.
# Comment lines are prose, not code: "yields nothing as CSS" and "measured, as CSS custom-property
# names" both matched the `as <Capitalised>` arm and blocked a commit that contained no cast at all.
# Lines *opening* with a comment marker are dropped; a trailing `// as Foo` after real code is not,
# because that line still starts with the code. Same for an alias clause — `export { x as Y }` and
# `import { x as y }` match the `as <Capitalised>` arm and contain no cast, and no cast can appear
# inside one, so dropping the whole line loses no enforcement.
# The same is true of a NAMESPACE import: `import * as React`, `import type * as React` and
# `export * as x` all match the `as <Capitalised>` arm, and a cast cannot appear inside one either.
# Fourteen vendored shadcn components opening with `import type * as React from 'react'` blocked a
# commit that contained no cast at all, which is the second time this grep has flagged syntax
# rather than a cast [see the comment lines above]. The arms below now cover `{` and `*`, with an
# optional `type` between.
hits=$(git diff --cached --name-only --diff-filter=ACM -z -- '*.ts' '*.tsx' \
       | xargs -0 -r grep -nE '\bas\s+(unknown|any|string|number|boolean|[A-Z][A-Za-z0-9_]*)\b' \
       | grep -vE ':[[:space:]]*(\*|//|/\*)' \
       | grep -vE ':[[:space:]]*(export|import)[[:space:]]*(type[[:space:]]+)?[{*]' \
       || true)
if [ -n "$hits" ]; then
  echo "$hits" >&2
  echo "error: type assertion found. Narrow it, add a runtime guard, or fix the type. [ENGINEERING §1.4]" >&2
  exit 1
fi
